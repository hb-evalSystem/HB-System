# HB-Eval Environment Configuration
# ============================================================
# Copy this file to .env and fill in your keys.
# NEVER commit .env to version control.
# All keys for Methodologies A and B are FREE (Groq free tier).
# Methodology C costs approximately $8.30 total.
# ============================================================

# Required for Methodologies A and B (free tier)
# Obtain at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_key_here

# Required for Methodology C — GPT-4o and Claude 3.5 Sonnet (~$8.10)
# Obtain at: https://openrouter.ai
OPENROUTER_API_KEY=sk-or-your_openrouter_key_here

# Required for Methodology C — Gemini 2.5 Flash (~$0.20, free tier available)
# Obtain at: https://aistudio.google.com
GOOGLE_API_KEY=AIzaSy_your_google_key_here

# Required for Methodology C — independent judge (free tier)
# Can reuse the same Groq key or use a separate one
GROQ_JUDGE_API_KEY=gsk_your_groq_judge_key_here
